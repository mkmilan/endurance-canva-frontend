# Server-only. Never prefix these with NEXT_PUBLIC_.
BACKEND_API_URL=http://127.0.0.1:4000
BACKEND_SERVICE_TOKEN=replace-with-the-backend-service-token
# Exact browser origin for creator sessions. Use only the production domain on
# Vercel; previews stay in demo mode. Match localhost vs 127.0.0.1 when testing.
STUDIO_ORIGIN=http://localhost:3000
